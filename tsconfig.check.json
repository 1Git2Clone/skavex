{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"emitDeclarationOnly": false,
		"checkJs": true,
		"allowImportingTsExtensions": true,
		"rootDir": "."
	},
	"include": [
		"src/**/*.js",
		"test/**/*.js",
		"bench/**/*.js",
		"e2e/**/*.js",
		"scripts/**/*.js",
		"*.js",
		"bench/**/*.d.ts"
	],
	"exclude": ["test/fixtures/**", "demo/dist/**"]
}
