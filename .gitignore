node_modules/
# CI's runner has no writable HOME, so pnpm puts its content-addressable store
# here instead of under XDG_DATA_HOME. It never appears locally, which is why
# `prettier --check .` passed on a developer machine and failed on the runner.
.pnpm-store/
result
test/.tmp/
coverage/
demo/dist/
test-results/
playwright-report/
# Regenerated by `pnpm bench`. The findings live in BENCHMARKS.md; committing
# the raw numbers would churn on every run and measure the machine, not the code.
bench/results*.json
*.tgz
types/
docs/book/

# pre-commit keeps its hook environments here when HOME is not writable.
.pre-commit-cache/

# svelte-check --tsgo writes a shadow tsconfig and generated .ts files for the
# workspace it checks. Regenerated on every run, and CI's Docs step fails on a
# dirty tree, so it cannot be left untracked either.
demo/.svelte-check/
